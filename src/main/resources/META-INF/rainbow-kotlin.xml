<!-- 仅在 Kotlin 插件存在时加载：作用域感知的 Kotlin 变量彩虹着色。 -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <highlightingPassFactory
                implementation="com.hua.rainbow_parentheses.kotlin.KotlinRainbowVariablesPassFactory"/>
        <highlightingPassFactory
                implementation="com.hua.rainbow_parentheses.kotlin.KotlinLambdaArrowPassFactory"/>
    </extensions>
</idea-plugin>
